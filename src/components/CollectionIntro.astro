---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  count: number;
  unit: string;
}

const { eyebrow, title, description, count, unit } = Astro.props;
---

<section class="page-intro shell">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-intro__description">{description}</p>
  </div>
  <div class="page-intro__count" aria-label={`公開中 ${count}${unit}`}>
    <strong>{count.toString().padStart(2, '0')}</strong>
    <span>公開中 / {unit}</span>
  </div>
</section>
