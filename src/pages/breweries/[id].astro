---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { isPublished } from '@/lib/content';

export async function getStaticPaths() {
  const entries = (await getCollection('breweries')).filter(isPublished);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'breweries'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.name}
  description={entry.data.summary}
  eyebrow={`BREWERY / ${entry.data.municipality}`}
  claimStatus={entry.data.claimStatus}
  permissionStatus={entry.data.permissionStatus}
  lastVerifiedAt={entry.data.lastVerifiedAt}
  updatedAt={entry.data.updatedAt}
  sourceCount={entry.data.sourceIds.length}
>
  <dl class="info-grid">
    <div><dt>読み</dt><dd>{entry.data.reading}</dd></div><div>
      <dt>自治体</dt><dd>{entry.data.municipality}</dd>
    </div><div><dt>当事者確認</dt><dd>{entry.data.partnerVerifiedAt ?? '未実施'}</dd></div><div>
      <dt>公式サイト</dt><dd>
        {entry.data.officialUrl ? <a href={entry.data.officialUrl}>確認する ↗</a> : '未登録'}
      </dd>
    </div>
  </dl>
  <Content />
</ArticleLayout>
