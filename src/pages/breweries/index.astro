---
import { getCollection } from 'astro:content';
import CollectionIntro from '@/components/CollectionIntro.astro';
import EmptyState from '@/components/EmptyState.astro';
import EntryCard from '@/components/EntryCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isPublished } from '@/lib/content';
import { withBase } from '@/lib/paths';

const entries = (await getCollection('breweries')).filter(isPublished);
---

<BaseLayout title="酒蔵" description="掲載基準と確認状態を明示した、新潟県内の酒蔵記録。">
  <CollectionIntro
    eyebrow="BREWERIES"
    title="酒蔵"
    description="網羅を装わず、運営が出典を確認した酒蔵から掲載します。当事者確認済みか、公開資料による確認かを各ページに表示します。"
    count={entries.length}
    unit="蔵"
  />
  <section class="content-section shell">
    {
      entries.length === 0 ? (
        <EmptyState
          title="確認済みの酒蔵情報を準備しています。"
          body="件数を増やすより、最初の一件で事実・出典・許諾・訂正導線が機能することを優先します。"
          action="partners"
        />
      ) : (
        <div class="entry-grid">
          {entries.map((entry) => (
            <EntryCard
              href={withBase(`/breweries/${entry.id}/`)}
              eyebrow={entry.data.municipality}
              title={entry.data.name}
              summary={entry.data.summary}
              status={entry.data.claimStatus}
              updatedAt={entry.data.updatedAt}
            />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
